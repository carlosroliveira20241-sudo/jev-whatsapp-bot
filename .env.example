# Jev (TypeSafe AI)
# "typesafe" = chamada direta a api.typesafe.ai (requer conta em console.typesafe.ai)
# "vercel-gateway" = fallback via Vercel AI Gateway, use se o cadastro direto estiver pausado
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

# Evolution API (self-hosted, ver docker-compose.yml)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jev-bot

# Servidor do bot
PORT=3000

# Confianca minima do Jev para usar a resposta escolhida (0-1); abaixo disso usa fallback
MIN_CONFIDENCE=0.4
